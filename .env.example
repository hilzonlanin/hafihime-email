# Resend transport (never commit real values)
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com

# Per-app clients as a JSON array. tokenHash = SHA-256 hex of the app's token.
# Generate a hash with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR-TOKEN').digest('hex'))"
CLIENTS=[
  {
    "id": "hafihime-batik",
    "tokenHash": "<sha256-hex-of-token>",
    "brandName": "Hafihime Batik",
    "fromAddress": "contact@hafihime.com",
    "ownerAddress": "owner@hafihime.com",
    "replyToAddress": "support@hafihime.com"
  }
]
